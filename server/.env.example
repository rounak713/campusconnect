# Core
DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET=""
KMS_PEPPER=""
KMS_PAIR_KEY=""
KMS_DIR_KEY=""
RAZORPAY_WEBHOOK_SECRET=""

# Student verification — email OTP (Method A)
# Leave both providers empty to use the zero-cost console transport in dev.
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CampusConnect <no-reply@campusconnect.in>"
APP_PUBLIC_URL="https://campusconnect.in"
OTP_PEPPER=""

# Student verification — private ID storage (Method B)
# S3 takes precedence over Cloudinary; with neither set, files go to LOCAL_ID_STORAGE_DIR (dev only).
S3_BUCKET=""
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
LOCAL_ID_STORAGE_DIR=""
ID_SIGNED_URL_TTL_SECONDS=300

# Admin review dashboard
# Shared secret for service-to-service admin calls (X-Admin-Key header); User.isAdmin also works.
ADMIN_API_KEY=""
SEED_ADMIN_PHONE="+919999000001"
