datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StudentStatus {
  PENDING_VERIFICATION
  PENDING_REVIEW
  VERIFIED
  SUSPENDED
  REJECTED
}

enum VerificationMethod {
  EMAIL_DOMAIN
  MANUAL_ID
}

enum VerificationRequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum StorageProvider {
  S3
  CLOUDINARY
  LOCAL
}

enum MatchStatus {
  WAITING_FOR_PAIR
  MUTUAL_MATCH
  UNMATCHED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

model College {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  shortCode   String   @unique
  domain      String?
  city        String
  state       String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  users       User[]
  domains     CollegeDomain[]

  @@index([shortCode])
}

model CollegeDomain {
  id         String   @id @default(uuid()) @db.Uuid
  domain     String   @unique
  collegeId  String?  @db.Uuid
  college    College? @relation(fields: [collegeId], references: [id])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([collegeId])
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  collegeId            String        @db.Uuid
  college              College       @relation(fields: [collegeId], references: [id])
  identityHash         String        @unique @db.VarChar(64)
  maskedPhone          String        @db.VarChar(20)
  instagramHash        String?       @unique @db.VarChar(64)
  maskedInstagram      String?       @db.VarChar(40)
  verificationStatus   StudentStatus @default(PENDING_VERIFICATION)
  verificationMethod   VerificationMethod?
  verifiedAt           DateTime?
  eduEmail             String?       @unique
  contactEmail         String?
  isAdmin              Boolean       @default(false)
  crushSlotsTotal      Int           @default(3)
  crushSlotsUsed       Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  
  commitments          CrushCommitment[]
  payments             PaymentOrder[]
  emailOtps            EmailOtp[]
  verificationRequests VerificationRequest[]

  @@index([identityHash])
  @@index([collegeId])
}

model EmailOtp {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  domain     String
  codeHash   String    @db.VarChar(64)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([email])
}

model VerificationRequest {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @db.Uuid
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageProvider StorageProvider
  storageKey      String
  mimeType        String                    @db.VarChar(64)
  sizeBytes       Int
  status          VerificationRequestStatus @default(PENDING_REVIEW)
  reviewerId      String?                   @db.Uuid
  reviewReason    String?
  reviewedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([userId])
  @@index([status])
}

model CrushCommitment {
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String      @db.Uuid
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rendezvousToken      String      @db.VarChar(64)
  directionalHash      String      @unique @db.VarChar(64)
  maskedTargetHint     String      @db.VarChar(40)
  status               MatchStatus @default(WAITING_FOR_PAIR)
  matchedAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  messages             EphemeralMessage[]

  @@index([rendezvousToken])
  @@index([userId])
}

model PaymentOrder {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  user             User          @relation(fields: [userId], references: [id])
  orderId          String        @unique
  paymentId        String?       @unique
  amountPaise      Int           @default(1000)
  currency         String        @default("INR")
  status           PaymentStatus @default(INITIATED)
  slotsGranted     Int           @default(1)
  idempotencyKey   String        @unique
  createdAt        DateTime      @default(now())
  confirmedAt      DateTime?

  @@index([orderId])
  @@index([userId])
}

model EphemeralMessage {
  id               String           @id @default(uuid()) @db.Uuid
  commitmentId     String           @db.Uuid
  commitment       CrushCommitment  @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  senderUserId     String           @db.Uuid
  ciphertext       String
  isEncrypted      Boolean          @default(true)
  createdAt        DateTime         @default(now())

  @@index([commitmentId])
}
